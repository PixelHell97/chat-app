<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.TocTalk" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="android:statusBarColor">@color/white_smoke</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorControlActivated">@color/black</item>
        <item name="android:textColorHighlight">@color/overlay</item>
    </style>

    <style name="Theme.TocTalk" parent="Base.Theme.TocTalk" />

    <style name="Theme.TocTalk.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.TocTalk.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.TocTalk.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="CircularPhoto">
        <item name="cornerSize">50%</item>
    </style>

    <style name="Caption_Bold">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/roboto_bold</item>
    </style>

    <style name="Footnote">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="fontFamily">@font/roboto_regular</item>
    </style>

    <style name="Footnote_Bold">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="fontFamily">@font/roboto_medium</item>
    </style>

    <style name="Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="fontFamily">@font/roboto_medium</item>
    </style>

    <style name="Body_Bold">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="fontFamily">@font/roboto_bold</item>
    </style>

    <style name="Headline">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="fontFamily">@font/roboto_medium</item>
    </style>

    <style name="Headline_Bold">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="fontFamily">@font/roboto_bold</item>
    </style>

    <style name="Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">normal</item>
        <item name="fontFamily">@font/roboto_bold</item>
    </style>
</resources>